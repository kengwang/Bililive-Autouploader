@page "/jobs"
@attribute [Authorize]
@implements IAsyncDisposable
@inject IUploadJobStore JobStore
@inject IUploadJobQueue Queue
@rendermode InteractiveServer

<PageTitle>任务列表 - 录播上传面板</PageTitle>
<div class="page-heading"><div><p class="eyebrow">UPLOAD QUEUE</p><h1>任务列表</h1><p class="muted">查看同步进度、错误和重试次数，打开任务可以查看文件明细。</p></div><button @onclick="() => ReloadAsync()" disabled="@_busy">刷新</button></div>
@if (_error is not null) { <p class="error">@_error</p> }
<section class="card live-summary"><div><strong>实时上传</strong><span class="muted">每秒自动刷新</span></div><div><strong>@RunningCount</strong><span class="muted">个进行中</span></div><div><strong>@Progress(_jobs.Where(IsActive).ToList())</strong><span class="muted">总体进度</span></div><div><strong>@Speed(_jobs.Where(IsActive).ToList())</strong><span class="muted">总速度</span></div></section>
<section class="card"><div class="compare-toolbar"><label>状态 <select @bind="_statusFilter"><option value="">全部</option>@foreach (var status in Enum.GetValues<UploadJobStatus>()) { <option value="@status">@status</option> }</select></label><span class="muted">显示 @_visibleJobs.Count / @_jobs.Count 个任务，已选择 @_selected.Count 个</span><div class="toolbar"><button @onclick="BatchRetryAsync" disabled="@(_selected.Count == 0 || _busy)">批量重试</button><button class="secondary-button" @onclick="BatchPauseAsync" disabled="@(_selected.Count == 0 || _busy)">批量暂停</button><button class="secondary-button" @onclick="BatchResumeAsync" disabled="@(_selected.Count == 0 || _busy)">批量恢复</button><button class="secondary-button" @onclick="BatchCancelAsync" disabled="@(_selected.Count == 0 || _busy)">批量取消</button><button class="danger-button" @onclick="AskBatchDelete" disabled="@(_selected.Count == 0 || _busy)">删除任务</button></div></div><div class="table-scroll"><table><thead><tr><th><input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleVisible" /></th><th>状态</th><th>路径组</th><th>进度</th><th>速度</th><th>重试</th><th>错误</th><th>创建时间</th><th>操作</th></tr></thead><tbody>@foreach (var job in _visibleJobs) { <tr><td><input type="checkbox" checked="@IsSelected(job.Id)" @onchange="e => Toggle(job.Id, e)" /></td><td><span class="status">@job.Status</span></td><td class="path-cell">@job.LocalGroupKey</td><td>@Progress(job)</td><td>@Speed(job)</td><td>@job.AttemptCount</td><td class="error-cell">@job.LastError</td><td>@job.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td><a class="button-link small-link" href="/jobs/@job.Id">详情</a><button @onclick="() => RetryAsync(job)" disabled="@(job.Status is UploadJobStatus.Running or UploadJobStatus.Pending)">重试</button></td></tr> }</tbody></table></div></section>
@if (_confirmDelete) { <section class="card confirm-card"><strong>确认删除 @_selected.Count 个任务？</strong><span class="muted">只删除任务记录，不会删除本地文件或百度云文件。</span><button class="danger-button" @onclick="BatchDeleteAsync">确认删除</button><button class="secondary-button" @onclick="() => _confirmDelete = false">取消</button></section> }
@code {
    private List<UploadJob> _jobs = [];
    private string _statusFilter = string.Empty;
    private bool _busy;
    private string? _error;
    private readonly HashSet<Guid> _selected = [];
    private bool _confirmDelete;
    private CancellationTokenSource? _refreshCts;
    private List<UploadJob> _visibleJobs => string.IsNullOrEmpty(_statusFilter) ? _jobs : _jobs.Where(x => x.Status.ToString() == _statusFilter).ToList();
    private bool AllVisibleSelected => _visibleJobs.Count > 0 && _visibleJobs.All(x => _selected.Contains(x.Id));
    protected override async Task OnInitializedAsync() { await ReloadAsync(); _refreshCts = new CancellationTokenSource(); _ = RefreshLoopAsync(_refreshCts.Token); }
    private async Task RefreshLoopAsync(CancellationToken cancellationToken) { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1)); try { while (await timer.WaitForNextTickAsync(cancellationToken)) { await ReloadAsync(false); await InvokeAsync(StateHasChanged); } } catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { } }
    private async Task ReloadAsync(bool showBusy = true) { if (showBusy) _busy = true; try { _jobs = (await JobStore.GetPageAsync(0, 200, CancellationToken.None)).ToList(); _selected.RemoveWhere(id => !_jobs.Any(x => x.Id == id)); _error = null; } catch (Exception ex) { _error = ex.Message; } finally { if (showBusy) _busy = false; } }
    public async ValueTask DisposeAsync() { if (_refreshCts is not null) { await _refreshCts.CancelAsync(); _refreshCts.Dispose(); } }
    private bool IsSelected(Guid id) => _selected.Contains(id);
    private void Toggle(Guid id, ChangeEventArgs args) { if ((bool)args.Value!) _selected.Add(id); else _selected.Remove(id); }
    private void ToggleVisible(ChangeEventArgs args) { var value = (bool)args.Value!; foreach (var job in _visibleJobs) { if (value) _selected.Add(job.Id); else _selected.Remove(job.Id); } }
    private async Task RetryAsync(UploadJob job) { await SetPendingAndQueueAsync(job); await ReloadAsync(); }
    private async Task BatchRetryAsync() { foreach (var job in SelectedJobs()) await SetPendingAndQueueAsync(job); await ReloadAsync(); }
    private async Task BatchPauseAsync() { foreach (var job in SelectedJobs()) { job.Status = UploadJobStatus.Paused; await JobStore.SaveAsync(job, CancellationToken.None); } await ReloadAsync(); }
    private async Task BatchResumeAsync() { foreach (var job in SelectedJobs()) { job.Status = UploadJobStatus.Pending; await JobStore.SaveAsync(job, CancellationToken.None); await Queue.EnqueueAsync(job.Id, CancellationToken.None); } await ReloadAsync(); }
    private async Task BatchCancelAsync() { foreach (var job in SelectedJobs()) { job.Status = UploadJobStatus.Canceled; await JobStore.SaveAsync(job, CancellationToken.None); } await ReloadAsync(); }
    private async Task SetPendingAndQueueAsync(UploadJob job) { job.Status = UploadJobStatus.Pending; job.NextAttemptAt = null; job.LastError = null; await JobStore.SaveAsync(job, CancellationToken.None); await Queue.EnqueueAsync(job.Id, CancellationToken.None); }
    private IEnumerable<UploadJob> SelectedJobs() => _jobs.Where(x => _selected.Contains(x.Id)).ToList();
    private void AskBatchDelete() => _confirmDelete = _selected.Count > 0;
    private async Task BatchDeleteAsync() { foreach (var id in _selected.ToArray()) await JobStore.DeleteAsync(id, CancellationToken.None); _selected.Clear(); _confirmDelete = false; await ReloadAsync(); }
    private static bool IsActive(UploadJob job) => job.Status is UploadJobStatus.Running or UploadJobStatus.Ready or UploadJobStatus.Pending or UploadJobStatus.WaitingForSidecars;
    private int RunningCount => _jobs.Count(x => x.Status == UploadJobStatus.Running);
    private static string Progress(UploadJob job) => job.TotalBytes == 0 ? "0%" : $"{job.UploadedBytes * 100 / job.TotalBytes}% ({job.UploadedBytes:N0}/{job.TotalBytes:N0})";
    private static string Progress(IReadOnlyCollection<UploadJob> jobs) { var total = jobs.Sum(x => x.TotalBytes); var uploaded = jobs.Sum(x => x.UploadedBytes); return total == 0 ? "0%" : $"{uploaded * 100 / total}% ({uploaded:N0}/{total:N0})"; }
    private static string Speed(UploadJob job) => Speed(new[] { job });
    private static string Speed(IReadOnlyCollection<UploadJob> jobs) { var value = jobs.Sum(x => x.UploadSpeedBytesPerSecond ?? 0); return value >= 1024 * 1024 ? $"{value / 1024 / 1024:N2} MiB/s" : value >= 1024 ? $"{value / 1024:N1} KiB/s" : $"{value:N0} B/s"; }
}
