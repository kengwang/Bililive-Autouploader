@page "/account/password"
@model BililiveAutoUploader.Web.Pages.Account.PasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>修改密码 · Bililive AutoUploader</title>
    <link rel="stylesheet" href="~/app.css" />
</head>
<body class="account-page">
    <main class="account-card">
        <div class="account-brand">Bililive AutoUploader</div>
        <h1>修改密码</h1>
        <p class="muted">新密码至少需要 12 个字符。</p>
        @if (Model.Changed)
        {
            <p class="success">密码已更新。</p>
        }
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label asp-for="CurrentPassword">当前密码</label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="validation"></span>
            <label asp-for="NewPassword">新密码</label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="validation"></span>
            <label asp-for="ConfirmPassword">确认新密码</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="validation"></span>
            <button type="submit" class="full-width">保存新密码</button>
        </form>
        <a class="account-link" href="/">返回面板</a>
    </main>
</body>
</html>
